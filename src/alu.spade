pub enum AluOp {
    Add,
    Sub,
    Sll,
    Slt,
    Sltu,
    Xor,
    Srl,
    Sra,
    Or,
    And
}

pub entity alu(a: int<64>, b: int<64>, op: AluOp) -> int<64> {
    match op {
        AluOp::Add => trunc(a + b),
        AluOp::Sub => trunc(a - b),
        AluOp::Xor => trunc(a ^ b),
        AluOp::Or  => trunc(a | b),
        AluOp::And => trunc(a & b),
        AluOp::Sll => trunc(a << trunc(b)), // Shift amount is lower bits of b
        // Slt, Sltu, Srl, Sra placeholders for now
        _ => 0
    }
}
