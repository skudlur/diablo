use std::mem::clocked_memory;
use std::mem::read_memory;

/// A 2-Read-Port, 1-Write-Port Integer Register File
/// x0 is hardwired to 0.
pub entity regfile(
    clk: clock,
    raddr1: uint<5>,
    raddr2: uint<5>,
    we: bool,
    waddr: uint<5>,
    wdata: int<64>
) -> (int<64>, int<64>) {
    
    // We only write if 'we' is true AND we aren't writing to x0
    let actual_we = we && (waddr != 0);

    // Spade's clocked_memory takes <NumElements, WritePorts, AddrWidth, DataType>
    // We duplicate the memory to get two asynchronous read ports.
    let mem1 = inst clocked_memory::<32, 1, 5, int<64>>(clk, [(actual_we, waddr, wdata)]);
    let mem2 = inst clocked_memory::<32, 1, 5, int<64>>(clk, [(actual_we, waddr, wdata)]);

    // Perform asynchronous reads
    let rdata1_raw = inst read_memory(mem1, raddr1);
    let rdata2_raw = inst read_memory(mem2, raddr2);

    // Enforce x0 == 0 during reads as well (to hide write-through latency)
    let rdata1 = if raddr1 == 0 { 0 } else { rdata1_raw };
    let rdata2 = if raddr2 == 0 { 0 } else { rdata2_raw };

    (rdata1, rdata2)
}
