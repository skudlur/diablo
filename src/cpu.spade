use diablo::isa::Instruction;
use diablo::alu::AluOp;
use diablo::alu::alu;
use diablo::regfile::regfile;
use diablo::decoder::decoder;
use diablo::pc::pc_reg;

pub pipeline(3) cpu(clk: clock, rst: bool) -> int<64> {
    // --------------------------------------------------------
    // Stage 1: Fetch
    // --------------------------------------------------------
    // Feedback loop: computed_next_pc comes from Execute stage (+2 stages ahead of Fetch)
    let next_pc = stage(+2).computed_next_pc;
    let pc = inst pc_reg(clk, rst, next_pc);
    
    let raw_inst: uint<32> = 0; // Placeholder for I-Memory read

    reg;
    // --------------------------------------------------------
    // Stage 2: Decode
    // --------------------------------------------------------
    let instr = Instruction$(
        opcode: trunc(raw_inst),
        rd: trunc(raw_inst >> 7),
        funct3: trunc(raw_inst >> 12),
        rs1: trunc(raw_inst >> 15),
        rs2: trunc(raw_inst >> 20),
        funct7: trunc(raw_inst >> 25)
    );

    // Decode instruction
    let decoded = inst decoder(instr);
    let alu_op = decoded.alu_op;

    // Feedback loop: Writeback signals come from Commit stage (+2 stages ahead of Decode)
    let we = stage(+2).commit_we;
    let waddr = stage(+2).commit_rd;
    let wdata = stage(+2).commit_result;

    // Read from the register file
    let (rs1_data, rs2_data) = inst regfile(clk, instr.rs1, instr.rs2, we, waddr, wdata);

    reg;
    // --------------------------------------------------------
    // Stage 3: Execute
    // --------------------------------------------------------
    let result = inst alu(rs1_data, rs2_data, alu_op);
    let computed_next_pc = trunc(pc + 4); // TODO: branch target logic

    reg;
    // --------------------------------------------------------
    // Stage 4: Commit
    // --------------------------------------------------------
    let commit_result = result;
    let commit_rd = instr.rd;
    let commit_we = decoded.write_reg;
    
    commit_result
}
