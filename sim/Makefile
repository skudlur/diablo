.PHONY: all clean run

# Path to the Verilog file generated by Spade (swim build)
SPADE_VERILOG = ../build/spade.sv

# Top module name in Verilog
TOP_MODULE = top

all: run

# Run Verilator to compile the C++ wrapper and Verilog into an executable
obj_dir/V$(TOP_MODULE): main.cpp $(SPADE_VERILOG) top.sv
	@echo "--- Compiling with Verilator ---"
	verilator -Wall -Wno-fatal --trace --cc --exe --build -j 4 main.cpp top.sv $(SPADE_VERILOG) --top-module $(TOP_MODULE)

# Run the simulation
run: obj_dir/V$(TOP_MODULE)
	@echo "--- Running Simulation ---"
	./obj_dir/V$(TOP_MODULE)

clean:
	rm -rf obj_dir
